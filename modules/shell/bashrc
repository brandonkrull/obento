# shellcheck shell=bash
# The shell module's settings, sourced from the end of each person's ~/.bashrc (modules/shell/install.sh).
# Edit in the repo: install.sh overwrites the installed copy. Your own additions go in ~/.bashrc after the line.
[[ $- == *i* ]] || return 0
grep -qsx shell /opt/obento/modules.on || return 0   # module turned off: leave the shell as Ubuntu has it

# A long, shared history: every window adds to it, and Ctrl-R searches it.
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend

if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --group-directories-first --git --time-style=relative'
  alias la='eza -la --group-directories-first --git --time-style=relative'
  alias tree='eza --tree'
fi
if command -v batcat >/dev/null; then
  alias bat='batcat'
  export MANPAGER="sh -c 'col -bx | batcat -l man -p'"   # man pages in colour
fi
[[ -r /usr/share/doc/fzf/examples/key-bindings.bash ]] && . /usr/share/doc/fzf/examples/key-bindings.bash
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
if command -v starship >/dev/null; then
  export STARSHIP_CONFIG=/opt/obento/modules/shell/starship.toml
  eval "$(starship init bash)"
fi

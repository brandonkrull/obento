#!/usr/bin/env bash
# Usage: obento <command> [app...]   Manage the apps in /opt/obento/compose. See 'obento help'.
set -euo pipefail

COMPOSE_DIR=/opt/obento/compose

usage() {
  cat <<'EOF'
Usage: obento <command> [app...]

Start, stop and check the home server's apps: the core ones (Immich, Vaultwarden, Jellyfin, AdGuard,
Scrutiny) and those of the modules that are on. Apps are the names 'obento apps' lists; leave them out to act
on all of them.

Commands:
  up [app...]           start (or apply changes to) apps; without apps, also removes those of modules turned off
  down                  stop and remove all apps (data is kept)
  stop [app...]         stop apps without removing them
  restart [app...]      restart apps
  status                list apps and whether they're running
  logs [-f] [app...]    show recent logs; -f keeps following
  update                get the latest setup: git pull in your repo, then sudo ./install.sh
  upgrade [app...]      download newer app versions (images), then restart what changed
  signups on|off        let new Vaultwarden accounts be created (off again after 'off' or any 'obento up')
  apps                  list app names
  modules               list the modules and which are on (MODULES in .env)
  setup <module>        connect a module's apps to each other (downloads; RUNBOOK)
  help                  show this help

Runs docker compose with sudo from /opt/obento/compose, so it uses the live settings in
/etc/obento/.env. After changing ~/obento, run 'sudo ./install.sh' there first.
EOF
}

compose() {
  [[ -f "$COMPOSE_DIR/docker-compose.yml" ]] || { echo "obento: $COMPOSE_DIR not installed; run 'sudo ./install.sh' in ~/obento" >&2; exit 1; }
  local sudo=() files=() f
  [[ $EUID -eq 0 ]] || sudo=(sudo)
  # The core compose file, each module's that is on, and the override, as install.sh listed them.
  if [[ -f "$COMPOSE_DIR/files" ]]; then
    while read -r f; do files+=(-f "$f"); done < "$COMPOSE_DIR/files"
  fi
  # env passes settings through sudo; compose prefers them over .env.
  (cd "$COMPOSE_DIR" && "${sudo[@]}" env "${COMPOSE_ENV[@]}" docker compose "${files[@]}" "$@")
}

list_modules() {
  local dir m on
  for dir in /opt/obento/modules/*/; do
    m="$(basename "$dir")"
    on="   "; grep -qx "$m" /opt/obento/modules.on 2>/dev/null && on="on "
    printf '%s %-10s %s\n' "$on" "$m" "$(sed -nE 's/^DESCRIPTION="(.*)"$/\1/p' "$dir/module.conf")"
  done
  echo "Change MODULES in ~/obento/.env, then 'obento update && obento up'."
}
COMPOSE_ENV=()

# git pull as the repo's owner (their GitHub key), then install.sh. exec, because install.sh replaces this file.
update_setup() {
  local repo owner
  repo="$(cat /opt/obento/repo-path 2>/dev/null)" || true
  [[ -d "$repo/.git" ]] || { echo "obento: repo not found; run 'sudo ./install.sh' in your obento folder once" >&2; exit 1; }
  owner="$(stat -c %U "$repo")"
  if [[ "$owner" == "$(id -un)" ]]; then git -C "$repo" pull --ff-only; else sudo -u "$owner" git -C "$repo" pull --ff-only; fi
  local sudo=()
  [[ $EUID -eq 0 ]] || sudo=(sudo)
  cd "$repo" && exec "${sudo[@]}" ./install.sh
}

cmd="${1:-help}"
(( $# )) && shift
case "$cmd" in
  up)               if (( $# )); then compose up -d "$@"; else compose up -d --remove-orphans; fi ;;
  down)             (( $# == 0 )) || { echo "obento: 'down' acts on all apps; use 'stop <app>' for one" >&2; exit 2; }
                    compose down ;;
  stop|restart)     compose "$cmd" "$@" ;;
  status|ps)        compose ps --all ;;
  logs)             follow=(); [[ "${1:-}" == -f ]] && { follow=(--follow); shift; }
                    compose logs --tail 100 "${follow[@]}" "$@" ;;
  update)           update_setup ;;
  upgrade)          compose pull "$@" && compose up -d "$@" ;;
  apps)             compose config --services ;;
  modules)          list_modules ;;
  setup|setup-downloads)
                    m="${1:-}"; [[ $cmd == setup-downloads ]] && m=downloads
                    [[ -f "/opt/obento/modules/$m/setup.sh" ]] || { echo "obento: no setup for module '$m'" >&2; exit 2; }
                    sudo=(); [[ $EUID -eq 0 ]] || sudo=(sudo)
                    exec "${sudo[@]}" "/opt/obento/modules/$m/setup.sh" ;;
  signups)          case "${1:-}" in
                      on)  COMPOSE_ENV=(VAULTWARDEN_SIGNUPS_ALLOWED=true); compose up -d vaultwarden
                           echo "Vaultwarden sign-ups are ON. Create the accounts, then run: obento signups off" ;;
                      off) compose up -d vaultwarden; echo "Vaultwarden sign-ups are off." ;;
                      *)   echo "obento: use 'obento signups on' or 'obento signups off'" >&2; exit 2 ;;
                    esac ;;
  help|-h|--help)   usage ;;
  *)                echo "obento: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac

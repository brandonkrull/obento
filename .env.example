# Copy to .env and fill in. Never commit .env.

# --- Notifications ---
# ntfy topic for alerts (use a long random name, or a self-hosted ntfy URL)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=change-me-long-random-topic
# Optional ntfy access token (leave blank for public ntfy.sh topics; needed for NTFY_EMAIL on ntfy.sh)
NTFY_TOKEN=
# Optional: also email high/urgent alerts (and Scrutiny's) to this address via ntfy. On ntfy.sh this needs a free
# account with this address verified, and that account's access token in NTFY_TOKEN; free accounts get 5 emails/day.
NTFY_EMAIL=

# --- Storage ---
POOL_NAME=tank
# Pool fill % that triggers a warning (lesson: leave slack)
POOL_WARN_PCT=80
# Before the HDDs arrive, Immich lives on the SSD here:
SSD_DATA=/srv
# After the pool exists, photos move to /tank/photos (see docs/RUNBOOK.md)
IMMICH_UPLOAD_LOCATION=/srv/immich/library
IMMICH_DB_LOCATION=/srv/immich/postgres

# --- Immich ---
IMMICH_VERSION=release
IMMICH_DB_PASSWORD=change-me-long-random
# Admin API key (create in Immich: Account Settings > API Keys) — used by verify-takeout.py
IMMICH_API_KEY=
IMMICH_URL=http://localhost:2283

# --- Modules: the optional parts (modules/README.md, 'obento modules') ---
# domain     own web addresses (photos.<APPS_DOMAIN>, ...) and the portal; needs APPS_DOMAIN and DESEC_TOKEN
# opencloud  files synced across devices
# ups        UPS on USB: clean shutdown, power alerts, the portal's battery gauge
# downloads  automatic TV and film downloads (needs domain)
# pi         the pi coding agent on the server, using your own model server (PI_URL, PI_MODEL below)
# Change it, then 'obento update && obento up'.
MODULES=opencloud,ups

# --- OpenCloud (files; module opencloud) ---
# Password for the 'admin' account, used on OpenCloud's first start only (change it later in OpenCloud)
OPENCLOUD_ADMIN_PASSWORD=change-me-long-random
# true lets tools like rclone sign in with an app token (used for the Google Drive import, RUNBOOK step 8)
OPENCLOUD_APP_TOKENS=false

# --- Your own web addresses (module domain; RUNBOOK "Your own web addresses") ---
# Apps get addresses like photos.<APPS_DOMAIN> instead of tamago.<tailnet>.ts.net ports.
APPS_DOMAIN=
# deSEC API token; APPS_DOMAIN is handed to deSEC (NS records) so the certificate can be proved there
DESEC_TOKEN=
# Rename an address: HOST_<NAME>=<new name>, e.g. HOST_REQUESTS=ask for ask.<APPS_DOMAIN> (names: 'HOSTS' in
# modules/*/module.conf). Every device using that app needs the new address.
# Optional: your own name and image on the portal (https://<APPS_DOMAIN>); the image is shown as a link, e.g.
# PORTAL_LOGO=https://example.com/logo.png
PORTAL_TITLE=
PORTAL_LOGO=

# --- pi coding agent (module pi) ---
# An OpenAI-compatible model server pi should use, e.g. http://my-gpu-box:8000/v1, and the model's id there.
# Written to ~/.pi/agent once; after that change pi's settings there.
PI_URL=
PI_MODEL=

# --- Automatic downloads (module downloads; RUNBOOK) ---
# 'sudo obento setup downloads' connects the apps using these. Your Usenet provider's server and login, and your indexer (as Prowlarr names it) and its API key.
# Put values with spaces or symbols in single quotes.
USENET_HOST=
USENET_PORT=563
USENET_USERNAME=
USENET_PASSWORD=
USENET_CONNECTIONS=20
NZB_INDEXER=NZBgeek
NZB_INDEXER_API_KEY=

# --- Off-site backup (Backblaze B2 via restic S3 API) ---
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/your-bucket-name/nas
RESTIC_PASSWORD=change-me-long-random-and-store-it-in-vaultwarden-AND-on-paper
AWS_ACCESS_KEY_ID=your-b2-key-id
AWS_SECRET_ACCESS_KEY=your-b2-application-key

# --- Timezone ---
TZ=America/Los_Angeles

# --- Other app data (move to /tank/... after the pool exists) ---
VAULTWARDEN_DATA=/srv/vaultwarden
OPENCLOUD_DATA=/srv/opencloud/data
MEDIA_LOCATION=/srv/media
